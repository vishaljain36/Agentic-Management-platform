# ==============================================================================
# Production Environment Variables: Backend API (apps/api / apps/agent-backend)
# ==============================================================================

# ----------------- Core Application -----------------
NODE_ENV=production
PROJECT_NAME="Agentic Workspace Backend"
VERSION=1.0.0
PORT=8000
WEB_CONCURRENCY=4

# ----------------- Database (Supabase / Neon) -----------------
# Pooled connection string (Port 6543 on Supabase / PgBouncer enabled on Neon)
DATABASE_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Direct unpooled connection string (Port 5432) for Prisma DDL migrations
DIRECT_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ----------------- Vector Store (Qdrant Cloud) -----------------
QDRANT_URL="https://[cluster-id].[region].aws.cloud.qdrant.io:6333"
QDRANT_API_KEY="your-qdrant-cloud-api-key"
QDRANT_COLLECTION_NAME="workspace_documents"
QDRANT_VECTOR_DIM=1536

# ----------------- Session Cache & Task Queue (Upstash Redis) -----------------
REDIS_URL="rediss://default:[token]@[cluster-id].upstash.io:6379"

# ----------------- Code Sandbox (E2B Cloud) -----------------
E2B_API_KEY="e2b_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ----------------- Observability & Telemetry (Langfuse) -----------------
LANGFUSE_PUBLIC_KEY="pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
LANGFUSE_SECRET_KEY="sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
LANGFUSE_HOST="https://cloud.langfuse.com"

# ----------------- LLM Provider Secrets -----------------
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx"
ANTHROPIC_API_KEY="sk-ant-api03-xxxxxxxxxxxxxxxx"
GOOGLE_GEMINI_API_KEY="AIzaSyxxxxxxxxxxxxxxxxxxxx"
DEEPSEEK_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ----------------- Security & Authentication -----------------
JWT_SECRET="generate-a-strong-32-character-secret-in-production"
ALGORITHM="HS256"

# ----------------- Billing & Metering -----------------
STRIPE_SECRET_KEY="sk_live_xxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxx"
LAGO_API_KEY="lago_live_xxxxxxxxxxxxxxxxxxxx"

