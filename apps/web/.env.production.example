# ==============================================================================
# Production Environment Variables: Next.js Frontend (apps/web)
# ==============================================================================

NODE_ENV=production

# ----------------- Public Frontend Configuration -----------------
NEXT_PUBLIC_APP_URL="https://app.agentic-void.io"
NEXT_PUBLIC_API_URL="https://api.agentic-void.io/api/v1"
NEXT_PUBLIC_WS_URL="wss://api.agentic-void.io/api/v1/ws"

# ----------------- Database Direct Access (Server Components) -----------------
DATABASE_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"

# ----------------- Stripe Billing & Webhook Secrets -----------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_xxxxxxxxxxxxxxxxxxxx"
STRIPE_SECRET_KEY="sk_live_xxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxx"

# ----------------- Lago Metering Webhooks -----------------
LAGO_API_URL="https://api.getlago.com"
LAGO_API_KEY="lago_live_xxxxxxxxxxxxxxxxxxxx"
LAGO_WEBHOOK_SECRET="lago_whsec_xxxxxxxxxxxxxxxxxxxx"

# ----------------- Observability & Telemetry -----------------
NEXT_PUBLIC_LANGFUSE_PUBLIC_KEY="pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
NEXT_PUBLIC_LANGFUSE_HOST="https://cloud.langfuse.com"

